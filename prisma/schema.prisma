generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Website {
  id              String   @id @default(cuid())
  title           String
  description     String
  longDescription String?
  thumbnail       String
  liveUrl         String
  demoUrl         String?
  isForSale       Boolean  @default(false)
  oldPrice        Float?
  newPrice        Float?
  tags            String[] @default([])
  privateNotes    String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default("default")
  siteName  String   @default("nexus265")
  tagline   String   @default("where ideas connect.")
  logo      String?
  heroImage String?
  favicon   String?
  email     String   @default("officialnexus265@gmail.com")
  phone     String   @default("+265999939040")
  whatsapp  String   @default("265999939040")
  social    Json     @default("{}")
  slides       Json?
  slideSpeedMs Int   @default(7000)
  updatedAt    DateTime @updatedAt
}


model ChatSession {
  id           String        @id @default(cuid())
  visitorName  String?
  visitorEmail String?
  status       String        @default("open") // open | active | closed
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String      // visitor | admin
  body      String
  createdAt DateTime    @default(now())
}
