generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Website {
  id              String   @id @default(cuid())
  title           String
  description     String
  longDescription String?
  thumbnail       String
  liveUrl         String
  demoUrl         String?
  isForSale       Boolean  @default(false)
  oldPrice        Float?
  newPrice        Float?
  tags            String[] @default([])
  privateNotes    String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default("default")
  siteName  String   @default("nexus265")
  tagline   String   @default("where ideas connect.")
  logo      String?
  heroImage String?
  favicon   String?
  email     String   @default("officialnexus265@gmail.com")
  phone     String   @default("+265999939040")
  whatsapp  String   @default("265999939040")
  social    Json     @default("{}")
  slides       Json?
  slideSpeedMs Int   @default(7000)
  agentName          String  @default("Alex")
  agentGender        String  @default("female")
  agentAvatarMale    String?
  agentAvatarFemale  String?
  updatedAt    DateTime @updatedAt
}


model ChatSession {
  id           String        @id @default(cuid())
  visitorName  String?
  visitorEmail String?
  status       String        @default("open") // open | active | closed
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String      // visitor | admin
  body      String
  createdAt DateTime    @default(now())
}


model ChatFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  options   Json?    // optional quick replies after this answer [{label, nextFaqId?}]
  parentId  String?  // null = top-level menu option
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatPendingQuestion {
  id           String   @id @default(cuid())
  sessionId    String?
  question     String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}


model BotNode {
  id          String      @id @default(cuid())
  kind        String      @default("message") // welcome | message
  title       String      @default("") // admin label on canvas
  body        String      @default("")
  positionX   Float       @default(0)
  positionY   Float       @default(0)
  isWelcome   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  options     BotOption[] @relation("NodeOptions")
  incoming    BotOption[] @relation("OptionTarget")
}

model BotOption {
  id         String   @id @default(cuid())
  nodeId     String
  node       BotNode  @relation("NodeOptions", fields: [nodeId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int      @default(0)
  // next = only next message | url = open page | human = live agent | next_url = message then can also have url on next
  action     String   @default("next") // next | url | human | next_url
  nextNodeId String?
  nextNode   BotNode? @relation("OptionTarget", fields: [nextNodeId], references: [id], onDelete: SetNull)
  url        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BotLanguage {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. en, ny, fr
  name      String   // e.g. English, Chichewa
  isActive  Boolean  @default(false)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BotTranslation {
  id         String   @id @default(cuid())
  languageId String
  // targetType: node_body | option_label
  targetType String
  targetId   String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([languageId, targetType, targetId])
}
